@@ -0,0 +1,235 @@
+/** Versioned reservation accounting; no IO or second ledger is owned here. */
+export interface UsageBuckets {
+  inputTokens: number
+  cacheReadTokens: number
+  cacheWriteTokens: number
+  outputTokens: number
+}
+export type BudgetPurpose = 'work' | 'finalize'
+export interface ReservationRequest {
+  scopeKey: string
+  modelCallId: string
+  sessionId: string
+  provider: string
+  model: string
+  purpose: BudgetPurpose
+  estimatedTokens: number
+}
+export interface Reservation extends ReservationRequest {
+  reservationId: string
+  status: 'reserved' | 'dispatched' | 'settled' | 'released_unsent' | 'unknown'
+  usage?: UsageBuckets
+  reason?: string
+}
+export interface Allocation {
+  limitTokens: number
+  usedTokens: number
+  reservedTokens: number
+  availableTokens: number
+}
+export interface BudgetSnapshot extends Allocation {
+  scopeKey: string
+  ledgerSeq: number
+  unknownCalls: number
+  exhausted: boolean
+  meteringComplete: boolean
+  usage: UsageBuckets
+  work: Allocation
+  finalize: Allocation
+}
+export type ReservationDecision =
+  | { allowed: true; reservation: Reservation; replayed: boolean }
+  | { allowed: false; reason: 'BUDGET_UNAVAILABLE' | 'USAGE_UNKNOWN' | 'CONCURRENT_LIMIT'; snapshot: BudgetSnapshot }
+export interface ReservationFields {
+  reservations: Map<string, Reservation>
+  finalizeLimit: number
+}
+export interface AccountingState extends ReservationFields {
+  open: { limitTokens: number } | undefined
+  usage: UsageBuckets
+  samples: Map<string, UsageBuckets>
+  unmetered: Set<string>
+  pending: Set<string>
+}
+type Header = { version: 2; scopeKey: string; eventId: string }
+export type ReservationEvent = Header & (
+  | { type: 'allocate'; finalizeTokens: number; reason: string }
+  | { type: 'reserve'; request: ReservationRequest; reservationId: string }
+  | { type: 'dispatch'; reservationId: string }
+  | { type: 'settle'; reservationId: string; usage: UsageBuckets }
+  | { type: 'release-unsent' | 'unknown'; reservationId: string; reason: string }
+)
+export interface BudgetEventReceipt {
+  cursor: number
+  eventId: string
+  scopeKey: string
+  type: string
+  payload: Readonly<Record<string, unknown>>
+}
+export interface AgentBudgetService {
+  /** Trusted call context; callback must consume the call within this scope. */
+  withPurpose<T>(sessionId: string, purpose: BudgetPurpose, callback: () => T): T
+  /** Trusted correlation context; callback must consume exactly one provider stream. */
+  withCallIdentity<T>(sessionId: string, modelCallId: string, callback: () => T): T
+  scopeForSession(sessionId: string, options?: { create?: boolean }): string
+  snapshot(scopeKey: string): BudgetSnapshot
+  reserve(request: ReservationRequest): ReservationDecision
+  markDispatched(reservationId: string): void
+  settle(reservationId: string, usage: UsageBuckets): void
+  releaseUnsent(reservationId: string, reason: string): void
+  markUnknown(reservationId: string, reason: string): void
+  /** Trusted operator/runtime configuration, never registered as a model tool. */
+  allocate(scopeKey: string, finalizeTokens: number, reason: string): void
+  eventsAfter(cursor: number): BudgetEventReceipt[]
+}
+
+export function tokenCount(value: unknown, label: string): asserts value is number {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) throw new TypeError(`agent-budget: invalid ${label}`)
+}
+export function usageTotal(usage: UsageBuckets): number {
+  for (const key of ['inputTokens', 'cacheReadTokens', 'cacheWriteTokens', 'outputTokens'] as const) {
+    tokenCount(usage[key], `usage.${key}`)
+  }
+  const total = usage.inputTokens + usage.cacheReadTokens + usage.cacheWriteTokens + usage.outputTokens
+  tokenCount(total, 'usage total')
+  return total
+}
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+function text(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0
+}
+export function assertReservationRequest(value: unknown): asserts value is ReservationRequest {
+  if (!record(value)) throw new TypeError('agent-budget: invalid reservation request')
+  if (![value.scopeKey, value.modelCallId, value.sessionId, value.provider, value.model].every(text)) {
+    throw new TypeError('agent-budget: invalid reservation subject')
+  }
+  if (value.purpose !== 'work' && value.purpose !== 'finalize') throw new TypeError('agent-budget: invalid reservation purpose')
+  tokenCount(value.estimatedTokens, 'estimatedTokens')
+  if (value.estimatedTokens === 0) throw new TypeError('agent-budget: reservation must be positive')
+}
+function assertUsage(value: unknown): asserts value is UsageBuckets {
+  if (!record(value)) throw new TypeError('agent-budget: invalid usage')
+  for (const key of ['inputTokens', 'cacheReadTokens', 'cacheWriteTokens', 'outputTokens']) tokenCount(value[key], `usage.${key}`)
+}
+export function isReservationEvent(value: unknown): value is ReservationEvent {
+  if (!record(value) || value.version !== 2 || !text(value.scopeKey) || !text(value.eventId)) return false
+  try {
+    if (value.type === 'allocate') {
+      tokenCount(value.finalizeTokens, 'finalizeTokens')
+      return text(value.reason)
+    }
+    if (!text(value.reservationId)) return false
+    if (value.type === 'reserve') {
+      if (!record(value.request)) return false
+      assertReservationRequest(value.request)
+      return value.request.scopeKey === value.scopeKey
+    }
+    if (value.type === 'dispatch') return true
+    if (value.type === 'settle') {
+      if (!record(value.usage)) return false
+      assertUsage(value.usage)
+      usageTotal(value.usage)
+      return true
+    }
+    return (value.type === 'release-unsent' || value.type === 'unknown') && text(value.reason)
+  } catch { return false }
+}
+function sameRequest(a: ReservationRequest, b: ReservationRequest): boolean {
+  return a.scopeKey === b.scopeKey && a.modelCallId === b.modelCallId
+    && a.sessionId === b.sessionId && a.provider === b.provider && a.model === b.model
+    && a.purpose === b.purpose && a.estimatedTokens === b.estimatedTokens
+}
+export function sameReservationRequest(a: ReservationRequest, b: ReservationRequest): boolean {
+  return sameRequest(a, b)
+}
+export function pendingReservation(r: Reservation): boolean {
+  return r.status === 'reserved' || r.status === 'dispatched' || r.status === 'unknown'
+}
+
+function allocation(limitTokens: number, used: number, reserved: number): Allocation {
+  return { limitTokens, usedTokens: used, reservedTokens: reserved, availableTokens: Math.max(0, limitTokens - used - reserved) }
+}
+
+export function snapshotOf(scopeKey: string, state: AccountingState, ledgerSeq: number, failed: boolean, liveCallIds: ReadonlySet<string>): BudgetSnapshot {
+  if (!state.open) throw new Error('agent-budget: unknown budget scope')
+  const usedTokens = usageTotal(state.usage)
+  const reservations = [...state.reservations.values()]
+  const reservedTokens = reservations.filter(pendingReservation).reduce((a, r) => a + r.estimatedTokens, 0)
+  tokenCount(reservedTokens, 'reserved total')
+  const finalizeUsed = reservations.filter(r => r.purpose === 'finalize' && r.usage).reduce((a, r) => a + usageTotal(r.usage!), 0)
+  const finalizeReserved = reservations.filter(r => r.purpose === 'finalize' && pendingReservation(r)).reduce((a, r) => a + r.estimatedTokens, 0)
+  const unknownIds = new Set(state.unmetered)
+  for (const callId of state.pending) if (!liveCallIds.has(callId)) unknownIds.add(callId)
+  for (const r of reservations) if (r.status === 'unknown' || (r.status === 'dispatched' && !liveCallIds.has(r.modelCallId))) unknownIds.add(r.modelCallId)
+  const global = allocation(state.open.limitTokens, usedTokens, reservedTokens)
+  return {
+    ...global, scopeKey, ledgerSeq, unknownCalls: unknownIds.size,
+    exhausted: failed || unknownIds.size > 0 || global.availableTokens === 0,
+    meteringComplete: unknownIds.size === 0, usage: { ...state.usage },
+    work: allocation(state.open.limitTokens - state.finalizeLimit, usedTokens - finalizeUsed, reservedTokens - finalizeReserved),
+    finalize: allocation(state.finalizeLimit, finalizeUsed, finalizeReserved),
+  }
+}
+
+/** Deterministic reducer. Caller validates against a clone before durable append. */
+export function foldReservationEvent(state: AccountingState, event: ReservationEvent): void {
+  if (!state.open) throw new Error('agent-budget: reservation event precedes open')
+  if (event.type === 'allocate') {
+    if (event.finalizeTokens > state.open.limitTokens) throw new Error('agent-budget: allocation exceeds global limit')
+    if ([...state.reservations.values()].some(pendingReservation)) throw new Error('agent-budget: cannot reallocate while reservations are unresolved')
+    state.finalizeLimit = event.finalizeTokens
+    return
+  }
+  if (event.type === 'reserve') {
+    const existing = state.reservations.get(event.reservationId)
+    if (existing) {
+      if (!sameRequest(existing, event.request)) throw new Error('agent-budget: conflicting duplicate reservation')
+      return
+    }
+    if ([...state.reservations.values()].some(r => r.modelCallId === event.request.modelCallId)
+      || state.samples.has(event.request.modelCallId) || state.unmetered.has(event.request.modelCallId) || state.pending.has(event.request.modelCallId)) {
+      throw new Error('agent-budget: modelCallId already accounted')
+    }
+    const available = snapshotOf(event.scopeKey, state, 0, false, new Set())
+    if (event.request.estimatedTokens > available.availableTokens
+      || event.request.estimatedTokens > available[event.request.purpose].availableTokens) {
+      throw new Error('agent-budget: reservation exceeds available allocation')
+    }
+    state.reservations.set(event.reservationId, { ...event.request, reservationId: event.reservationId, status: 'reserved' })
+    return
+  }
+  const reservation = state.reservations.get(event.reservationId)
+  if (!reservation) throw new Error('agent-budget: unknown reservation')
+  if (event.type === 'dispatch') {
+    if (reservation.status === 'dispatched') return
+    if (reservation.status !== 'reserved') throw new Error('agent-budget: cannot dispatch non-reserved call')
+    reservation.status = 'dispatched'
+  } else if (event.type === 'release-unsent') {
+    if (reservation.status === 'released_unsent') return
+    if (reservation.status !== 'reserved') throw new Error('agent-budget: dispatched call cannot be released as unsent')
+    reservation.status = 'released_unsent'
+    reservation.reason = event.reason
+  } else if (event.type === 'unknown') {
+    if (reservation.status === 'unknown') return
+    if (reservation.status !== 'dispatched') throw new Error('agent-budget: only dispatched calls can become unknown')
+    reservation.status = 'unknown'
+    reservation.reason = event.reason
+  } else if (event.type === 'settle') {
+    const value = usageTotal(event.usage)
+    if (reservation.status === 'settled') {
+      if ((['inputTokens', 'cacheReadTokens', 'cacheWriteTokens', 'outputTokens'] as const).some(k => event.usage[k] !== reservation.usage?.[k])) throw new Error('agent-budget: conflicting settlement')
+      return
+    }
+    if (reservation.status !== 'dispatched' && reservation.status !== 'unknown') throw new Error('agent-budget: settle requires a dispatched or unknown call')
+    tokenCount(usageTotal(state.usage) + value, 'settled total')
+    for (const key of ['inputTokens', 'cacheReadTokens', 'cacheWriteTokens', 'outputTokens'] as const) state.usage[key] += event.usage[key]
+    state.samples.set(reservation.modelCallId, { ...event.usage })
+    state.unmetered.delete(reservation.modelCallId)
+    state.pending.delete(reservation.modelCallId)
+    reservation.status = 'settled'
+    reservation.usage = { ...event.usage }
+    delete reservation.reason
+  }
+}
