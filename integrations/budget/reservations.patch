index 0000000..63f6f65
--- /dev/null
+++ b/tests/reservations.spec.ts
@@ -0,0 +1,235 @@
+import { appendFileSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { describe, expect, it } from 'vitest'
+import type { AgentBudgetService, ReservationRequest } from '../src/index.ts'
+import { TestHarness, finish, usage } from './helpers.ts'
+
+const actual = (inputTokens: number, outputTokens = 0) => ({ inputTokens, outputTokens, cacheReadTokens: 0, cacheWriteTokens: 0 })
+function setup(maxTokens = 100, maxConcurrentCalls?: number) {
+  const harness = new TestHarness({ maxTokens, ...(maxConcurrentCalls === undefined ? {} : { maxConcurrentCalls }) })
+  harness.root('root')
+  const budget = harness.services.get('agentBudget') as AgentBudgetService
+  const scopeKey = budget.scopeForSession('root')
+  const request = (modelCallId: string, estimatedTokens: number, purpose: 'work' | 'finalize' = 'work'): ReservationRequest => ({
+    scopeKey, modelCallId, sessionId: 'root', provider: 'mock', model: 'mock-model', purpose, estimatedTokens,
+  })
+  const reserve = (callId: string, amount: number, purpose: 'work' | 'finalize' = 'work') => {
+    const decision = budget.reserve(request(callId, amount, purpose))
+    if (!decision.allowed) throw new Error(decision.reason)
+    return decision.reservation.reservationId
+  }
+  return { harness, budget, scopeKey, request, reserve }
+}
+
+describe('durable reservation service', () => {
+  it('replays the frozen v1 fixture with replacement samples exactly once', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'budget-legacy-fixture-'))
+    copyFileSync(new URL('./fixtures/legacy-ledger-v1.jsonl', import.meta.url), join(dir, 'ledger.jsonl'))
+    const harness = new TestHarness({ maxTokens: 9999, storageDir: dir })
+    const budget = harness.services.get('agentBudget') as AgentBudgetService
+    expect(budget.snapshot('fixture-root')).toMatchObject({ limitTokens: 100, usedTokens: 18, reservedTokens: 0, availableTokens: 82, unknownCalls: 0 })
+  })
+  it('atomically admits only one contender for the final capacity and persists before returning', async () => {
+    const { harness, budget, scopeKey, request } = setup(100)
+    const results = await Promise.all([Promise.resolve().then(() => budget.reserve(request('a', 70))), Promise.resolve().then(() => budget.reserve(request('b', 70)))])
+    expect(results.filter(x => x.allowed)).toHaveLength(1)
+    expect(budget.snapshot(scopeKey).reservedTokens).toBe(70)
+    expect(harness.ledgerLines().filter(x => x.type === 'reserve')).toHaveLength(1)
+    expect(existsSync(join(harness.storageDir, 'ledger.v1-backup.jsonl'))).toBe(true)
+  })
+
+  it('replays reserve without occupying more credit and rejects conflicting reuse', () => {
+    const { harness, budget, scopeKey, request } = setup()
+    const first = budget.reserve(request('same', 30))
+    const second = budget.reserve(request('same', 30))
+    expect(second).toMatchObject({ allowed: true, replayed: true })
+    expect(first.allowed && second.allowed && first.reservation.reservationId === second.reservation.reservationId).toBe(true)
+    expect(budget.snapshot(scopeKey).reservedTokens).toBe(30)
+    expect(() => budget.reserve(request('same', 31))).toThrow('conflicting')
+    expect(harness.ledgerLines().filter(x => x.type === 'reserve')).toHaveLength(1)
+  })
+
+  it('uses the original shared root for children and rejects a supplied scope mismatch', () => {
+    const { harness, budget, scopeKey, request } = setup()
+    const parent = harness.sessionsById.get('root')!
+    harness.child('child', parent)
+    expect(budget.scopeForSession('child')).toBe(scopeKey)
+    expect(budget.reserve({ ...request('child-call', 20), sessionId: 'child' }).allowed).toBe(true)
+    expect(() => budget.reserve({ ...request('wrong', 20), scopeKey: 'other' })).toThrow('scope mismatch')
+  })
+
+  it('settles actual use once and rejects a conflicting final usage', () => {
+    const { harness, budget, scopeKey, reserve } = setup()
+    const id = reserve('a', 40)
+    budget.markDispatched(id)
+    budget.settle(id, actual(12, 8))
+    budget.settle(id, actual(12, 8))
+    expect(budget.snapshot(scopeKey)).toMatchObject({ usedTokens: 20, reservedTokens: 0, availableTokens: 80 })
+    expect(harness.ledgerLines().filter(x => x.type === 'settle')).toHaveLength(1)
+    expect(() => budget.settle(id, actual(21))).toThrow('conflicting settlement')
+    expect(() => budget.markDispatched(id)).toThrow('non-reserved')
+  })
+
+  it('releases only known-unsent requests and never refunds a dispatched request', () => {
+    const { budget, scopeKey, reserve } = setup()
+    const unsent = reserve('unsent', 20)
+    budget.releaseUnsent(unsent, 'validation failed before dispatch')
+    budget.releaseUnsent(unsent, 'validation failed before dispatch')
+    expect(budget.snapshot(scopeKey).reservedTokens).toBe(0)
+    const sent = reserve('sent', 20)
+    budget.markDispatched(sent)
+    expect(() => budget.releaseUnsent(sent, 'client timed out')).toThrow('cannot be released')
+    budget.markUnknown(sent, 'client timed out')
+  })
+
+  it('blocks the root on unknown usage then accepts late authoritative settlement', () => {
+    const { budget, scopeKey, reserve, request } = setup()
+    const id = reserve('a', 30)
+    budget.markDispatched(id)
+    budget.markUnknown(id, 'connection lost')
+    expect(budget.snapshot(scopeKey)).toMatchObject({ unknownCalls: 1, reservedTokens: 30, meteringComplete: false })
+    expect(budget.reserve(request('b', 10))).toMatchObject({ allowed: false, reason: 'USAGE_UNKNOWN' })
+    budget.settle(id, actual(22))
+    expect(budget.snapshot(scopeKey)).toMatchObject({ unknownCalls: 0, usedTokens: 22, availableTokens: 78 })
+    expect(budget.reserve(request('b', 10)).allowed).toBe(true)
+  })
+
+  it('records actual overshoot without clipping it and denies later admission', () => {
+    const { budget, scopeKey, reserve, request } = setup(30)
+    const id = reserve('a', 20)
+    budget.markDispatched(id)
+    budget.settle(id, actual(40))
+    expect(budget.snapshot(scopeKey)).toMatchObject({ usedTokens: 40, availableTokens: 0, exhausted: true })
+    expect(budget.reserve(request('b', 1))).toMatchObject({ allowed: false, reason: 'BUDGET_UNAVAILABLE' })
+  })
+
+  it('keeps work and finalize allocations within the same global amount', () => {
+    const { budget, scopeKey, reserve, request } = setup(100)
+    budget.allocate(scopeKey, 10, 'reserve report allowance')
+    const id = reserve('work', 90)
+    expect(budget.reserve(request('extra-work', 1))).toMatchObject({ allowed: false, reason: 'BUDGET_UNAVAILABLE' })
+    const finalId = reserve('report', 10, 'finalize')
+    expect(budget.snapshot(scopeKey)).toMatchObject({ reservedTokens: 100, availableTokens: 0 })
+    budget.markDispatched(id)
+    budget.settle(id, actual(85))
+    budget.markDispatched(finalId)
+    budget.settle(finalId, actual(8))
+    expect(budget.snapshot(scopeKey)).toMatchObject({ usedTokens: 93, availableTokens: 7, work: { availableTokens: 5 }, finalize: { availableTokens: 2 } })
+  })
+
+  it('counts pending reservations against concurrency and rejects reallocation while unresolved', () => {
+    const { budget, scopeKey, request, reserve } = setup(100, 1)
+    const first = reserve('a', 10)
+    expect(budget.reserve(request('b', 10))).toMatchObject({ allowed: false, reason: 'CONCURRENT_LIMIT' })
+    expect(() => budget.allocate(scopeKey, 5, 'change')).toThrow('unresolved')
+    budget.releaseUnsent(first, 'not dispatched')
+    expect(budget.reserve(request('b', 10)).allowed).toBe(true)
+  })
+
+  it('does not mutate state or write an event for invalid usage/transition', () => {
+    const { harness, budget, scopeKey, reserve } = setup()
+    const id = reserve('a', 10)
+    const count = harness.ledgerLines().length
+    expect(() => budget.settle(id, actual(5))).toThrow('requires')
+    expect(() => budget.markUnknown(id, 'not sent')).toThrow('only dispatched')
+    expect(harness.ledgerLines()).toHaveLength(count)
+    budget.markDispatched(id)
+    expect(() => budget.settle(id, actual(-1))).toThrow('invalid')
+    expect(budget.snapshot(scopeKey).usedTokens).toBe(0)
+    budget.markUnknown(id, 'invalid usage')
+  })
+
+  it('replays old history and v2 settlements without resetting accumulated use', async () => {
+    const { harness, budget, scopeKey, reserve } = setup()
+    await harness.stream(harness.sessionsById.get('root'), [usage({ inputTokens: 5 }), finish()])
+    const id = reserve('new', 20)
+    budget.markDispatched(id)
+    budget.settle(id, actual(12))
+    const before = budget.snapshot(scopeKey)
+    harness.dispose()
+    const reloaded = new TestHarness({ maxTokens: 999, storageDir: harness.storageDir })
+    const service = reloaded.services.get('agentBudget') as AgentBudgetService
+    expect(service.snapshot(scopeKey)).toEqual(before)
+    expect(service.snapshot(scopeKey).limitTokens).toBe(100)
+  })
+
+  it('recovers a persisted dispatch as unknown rather than releasing its estimate', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'budget-reservation-crash-'))
+    const req: ReservationRequest = { scopeKey: 'root', modelCallId: 'a', sessionId: 'root', provider: 'mock', model: 'mock', purpose: 'work', estimatedTokens: 20 }
+    const lines = [
+      { type: 'open', version: 1, scopeKey: 'root', epochId: 'epoch', limitTokens: 100 },
+      { type: 'reserve', version: 2, scopeKey: 'root', eventId: 'r', reservationId: 'r1', request: req },
+      { type: 'dispatch', version: 2, scopeKey: 'root', eventId: 'd', reservationId: 'r1' },
+    ]
+    writeFileSync(join(dir, 'ledger.jsonl'), lines.map(x => JSON.stringify(x)).join('\n') + '\n')
+    const harness = new TestHarness({ maxTokens: 100, storageDir: dir })
+    const budget = harness.services.get('agentBudget') as AgentBudgetService
+    expect(budget.snapshot('root')).toMatchObject({ reservedTokens: 20, unknownCalls: 1 })
+    expect(harness.ledgerLines().at(-1)).toMatchObject({ type: 'unknown', reason: 'recovered-dispatch-without-settlement' })
+    budget.settle('r1', actual(8))
+    expect(budget.snapshot('root')).toMatchObject({ usedTokens: 8, reservedTokens: 0, unknownCalls: 0 })
+  })
+
+  it('provides stable replay receipts and immutable snapshots', () => {
+    const { budget, scopeKey, reserve } = setup()
+    const cursor = budget.snapshot(scopeKey).ledgerSeq
+    reserve('a', 10)
+    const receipts = budget.eventsAfter(cursor)
+    expect(receipts).toHaveLength(1)
+    expect(receipts[0]).toMatchObject({ type: 'reserve', cursor: cursor + 1 })
+    receipts[0]!.type = 'tampered'
+    expect(budget.eventsAfter(cursor)[0]!.type).toBe('reserve')
+    const snapshot = budget.snapshot(scopeKey)
+    snapshot.usage.inputTokens = 12345
+    expect(budget.snapshot(scopeKey).usedTokens).toBe(0)
+    expect(() => budget.eventsAfter(999)).toThrow('ahead')
+  })
+
+  it('fails closed when persistence fails before admission', () => {
+    const { harness, budget, request, scopeKey, reserve } = setup()
+    budget.releaseUnsent(reserve('initial', 1), 'not sent')
+    const ledger = join(harness.storageDir, 'ledger.jsonl')
+    const moved = join(harness.storageDir, 'ledger.test-backup')
+    renameSync(ledger, moved)
+    mkdirSync(ledger)
+    try {
+      expect(() => budget.reserve(request('a', 10))).toThrow()
+      expect(budget.snapshot(scopeKey)).toMatchObject({ reservedTokens: 0, exhausted: true })
+      expect(() => budget.reserve(request('b', 10))).toThrow('storage failed')
+    } finally {
+      rmdirSync(ledger)
+      renameSync(moved, ledger)
+    }
+    expect(harness.ledgerLines().filter(x => x.type === 'reserve')).toHaveLength(1)
+  })
+
+  it('refuses malformed v2 history and does not drop accounting records', () => {
+    const { harness, reserve } = setup()
+    reserve('a', 10)
+    harness.dispose()
+    appendFileSync(join(harness.storageDir, 'ledger.jsonl'), JSON.stringify({ type: 'settle', version: 2, scopeKey: 'root', eventId: 'bad', reservationId: 'missing', usage: actual(5) }) + '\n')
+    expect(() => new TestHarness({ maxTokens: 100, storageDir: harness.storageDir })).toThrow('unknown reservation')
+    expect(readFileSync(join(harness.storageDir, 'ledger.jsonl'), 'utf8')).toContain('"eventId":"bad"')
+  })
+
+  it('allows an in-flight call to settle while disposing, then releases the writer lease', () => {
+    const { harness, budget, reserve, scopeKey, request } = setup()
+    const id = reserve('a', 10)
+    budget.markDispatched(id)
+    harness.dispose()
+    expect(existsSync(join(harness.storageDir, 'writer.lock'))).toBe(true)
+    expect(() => budget.reserve(request('b', 5))).toThrow('disposed')
+    budget.settle(id, actual(5))
+    expect(budget.snapshot(scopeKey).usedTokens).toBe(5)
+    expect(existsSync(join(harness.storageDir, 'writer.lock'))).toBe(false)
+  })
+
+  it('denies a second writer and refuses unknown schema versions', () => {
+    const { harness } = setup()
+    expect(() => new TestHarness({ maxTokens: 100, storageDir: harness.storageDir })).toThrow('locked')
+    harness.dispose()
+    appendFileSync(join(harness.storageDir, 'ledger.jsonl'), JSON.stringify({ type: 'future', version: 99, scopeKey: 'root' }) + '\n')
+    expect(() => new TestHarness({ maxTokens: 100, storageDir: harness.storageDir })).toThrow('invalid ledger record')
+  })
+})
diff --git a/tests/writer-recovery.spec.ts b/tests/writer-recovery.spec.ts
new file mode 100644
index 0000000..e1fec82
--- /dev/null
+++ b/tests/writer-recovery.spec.ts
@@ -0,0 +1,69 @@
+import { spawn } from 'node:child_process'
+import { once } from 'node:events'
+import { existsSync, mkdtempSync, readFileSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it, vi } from 'vitest'
+import { recoverWriterLock } from '../scripts/recover-writer-lock.mjs'
+import { acquireStorageLock } from '../scripts/storage.mjs'
+
+const directory = () => mkdtempSync(join(tmpdir(), 'budget-lock-recovery-'))
+const lock = (dir: string, pid: number) => writeFileSync(join(dir, 'writer.lock'), JSON.stringify({ pid, id: 'stale-identity' }))
+
+describe('explicit stale writer recovery', () => {
+  it('recovers a lock left by an actually terminated writer without changing the ledger', async () => {
+    const dir = directory()
+    const moduleUrl = new URL('../scripts/storage.mjs', import.meta.url).href
+    const script = `import { acquireStorageLock } from ${JSON.stringify(moduleUrl)}; acquireStorageLock(${JSON.stringify(dir)}); process.send('locked'); setInterval(() => {}, 1000)`
+    const child = spawn(process.execPath, ['--input-type=module', '-e', script], { stdio: ['ignore', 'ignore', 'inherit', 'ipc'], windowsHide: true })
+    try {
+      await once(child, 'message')
+      const pid = child.pid!
+      const exited = once(child, 'exit')
+      child.kill('SIGKILL')
+      await exited
+      writeFileSync(join(dir, 'ledger.jsonl'), 'unchanged-history\n')
+      expect(recoverWriterLock(dir, pid)).toMatchObject({ recovered: true, pid })
+      expect(readFileSync(join(dir, 'ledger.jsonl'), 'utf8')).toBe('unchanged-history\n')
+      const release = acquireStorageLock(dir)
+      release()
+      expect(existsSync(join(dir, 'writer-recovery.lock'))).toBe(false)
+    } finally { if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL') }
+  })
+
+  it('refuses a live process and preserves the lock', () => {
+    const dir = directory()
+    lock(dir, process.pid)
+    expect(() => recoverWriterLock(dir, process.pid)).toThrow('still alive')
+    expect(existsSync(join(dir, 'writer.lock'))).toBe(true)
+    expect(existsSync(join(dir, 'writer-recovery.lock'))).toBe(false)
+  })
+
+  it('refuses mismatching operator identity, malformed data and invalid PIDs', () => {
+    const dir = directory()
+    lock(dir, process.pid)
+    expect(() => recoverWriterLock(dir, process.pid + 1)).toThrow('PID changed')
+    expect(() => recoverWriterLock(dir, 0)).toThrow('positive')
+    writeFileSync(join(dir, 'writer.lock'), '{"pid":null}')
+    expect(() => recoverWriterLock(dir, process.pid)).toThrow('invalid')
+  })
+
+  it('refuses uncertain liveness instead of treating a permission error as death', () => {
+    const dir = directory()
+    lock(dir, process.pid)
+    const probe = vi.spyOn(process, 'kill').mockImplementation(() => { throw Object.assign(new Error('permission denied'), { code: 'EPERM' }) })
+    try {
+      expect(() => recoverWriterLock(dir, process.pid)).toThrow('permission denied')
+      expect(existsSync(join(dir, 'writer.lock'))).toBe(true)
+    } finally { probe.mockRestore() }
+  })
+
+  it('serializes recovery and never removes an existing recovery guard', () => {
+    const dir = directory()
+    lock(dir, process.pid)
+    writeFileSync(join(dir, 'writer-recovery.lock'), 'another recovery')
+    expect(() => recoverWriterLock(dir, process.pid)).toThrow()
+    expect(readFileSync(join(dir, 'writer-recovery.lock'), 'utf8')).toBe('another recovery')
+    expect(existsSync(join(dir, 'writer.lock'))).toBe(true)
+  })
+})
