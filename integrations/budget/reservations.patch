@@ -0,0 +1,156 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import LlmRuntime, { LlmAdapter } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjection from '@deepseek-ai/dsh-session-projection'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import { mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { apply, inject, name } from '../src/index.ts'
+import type { AgentBudgetService } from '../src/index.ts'
+import { TestHarness, finish, text, usage } from './helpers.ts'
+
+describe('opt-in provider reservation hook', () => {
+  it('keeps concurrent same-session streams bound to their trusted call identities', async () => {
+    const h = new TestHarness({ maxTokens: 2000, reservationMode: true })
+    const root = h.root('root')
+    const service = h.services.get('agentBudget') as AgentBudgetService
+    const handler = h.streamHandlers[0]!
+    let started = 0
+    let releaseBoth!: () => void
+    const bothStarted = new Promise<void>(resolve => { releaseBoth = resolve })
+    const run = (modelCallId: string, inputTokens: number) => service.withCallIdentity('root', modelCallId, async () => {
+      const options: GenerateOptions = { provider: 'mock', model: 'mock-model', sessionId: root.id, messages: [], maxTokens: 50 }
+      const iterable = handler(options, async function* () {
+        started += 1
+        if (started === 2) releaseBoth()
+        await bothStarted
+        yield usage({ inputTokens })
+        yield finish()
+      })
+      return Array.fromAsync(iterable)
+    })
+    await Promise.all([run('call-a', 7), run('call-b', 11)])
+    const reservations = h.ledgerLines().filter(line => line.type === 'reserve') as Array<{ request: { modelCallId: string } }>
+    expect(reservations.map(line => line.request.modelCallId).toSorted()).toEqual(['call-a', 'call-b'])
+    expect(service.snapshot('root')).toMatchObject({ usedTokens: 18, reservedTokens: 0, unknownCalls: 0 })
+  })
+
+  it('settles only the final cumulative usage without legacy double-debit', async () => {
+    const h = new TestHarness({ maxTokens: 2000, reservationMode: true })
+    const root = h.root('root')
+    const service = h.services.get('agentBudget') as AgentBudgetService
+    await h.stream(root, [usage({ inputTokens: 5 }), usage({ inputTokens: 10, outputTokens: 3 }), finish()], { maxTokens: 50 })
+    expect(service.snapshot('root')).toMatchObject({ usedTokens: 13, reservedTokens: 0, unknownCalls: 0 })
+    expect(h.ledgerLines().map(x => x.type)).toEqual(['open', 'reserve', 'dispatch', 'settle'])
+  })
+
+  it('denies unscoped requests but admits unbounded ones against the allowance', async () => {
+    const h = new TestHarness({ maxTokens: 20_000, reservationMode: true })
+    const root = h.root('root')
+    let calls = 0
+    await expect(h.stream(undefined, [], { maxTokens: 50 }, () => { calls++ })).rejects.toMatchObject({ code: 'TOKEN_BUDGET_SESSION_REQUIRED' })
+    // No maxTokens: the call keeps the caller's own bound and reserves against
+    // the configured allowance instead of being rejected.
+    await h.stream(root, [usage({ inputTokens: 5 }), finish()], {}, () => { calls++ })
+    expect(calls).toBe(1)
+    expect(h.ledgerLines().filter(x => x.type === 'reserve')).toHaveLength(1)
+  })
+
+  it('does not release missing usage even when legacy missingUsage is ignore', async () => {
+    const h = new TestHarness({ maxTokens: 2000, reservationMode: true, missingUsage: 'ignore' })
+    const root = h.root('root')
+    const service = h.services.get('agentBudget') as AgentBudgetService
+    await h.stream(root, [text(), finish()], { maxTokens: 50 })
+    expect(service.snapshot('root')).toMatchObject({ unknownCalls: 1, meteringComplete: false })
+    await expect(h.stream(root, [usage(), finish()], { maxTokens: 50 })).rejects.toThrow('USAGE_UNKNOWN')
+    expect(h.ledgerLines().filter(x => x.type === 'reserve')).toHaveLength(1)
+  })
+
+  it('keeps a cancelled partial stream reserved until usage can be reconciled', async () => {
+    const h = new TestHarness({ maxTokens: 2000, reservationMode: true })
+    const root = h.root('root')
+    const service = h.services.get('agentBudget') as AgentBudgetService
+    const iterable = h.streamHandlers[0]!({ provider: 'mock', model: 'mock', sessionId: root.id, messages: [], maxTokens: 50 }, async function* () {
+      yield usage({ inputTokens: 10 })
+      yield text('unfinished')
+      yield finish()
+    })
+    for await (const chunk of iterable) { expect(chunk.type).toBe('usage'); break }
+    expect(service.snapshot('root')).toMatchObject({ usedTokens: 0, unknownCalls: 1 })
+    expect(service.snapshot('root').reservedTokens).toBeGreaterThan(0)
+  })
+
+  it('assigns finalize from a trusted async context and preserves the global limit', async () => {
+    const h = new TestHarness({ maxTokens: 1000, reservationMode: true })
+    const root = h.root('root')
+    const service = h.services.get('agentBudget') as AgentBudgetService
+    service.scopeForSession('root')
+    service.allocate('root', 400, 'operator configured report budget')
+    const decision = service.reserve({ scopeKey: 'root', sessionId: 'root', modelCallId: 'work', provider: 'mock', model: 'mock', estimatedTokens: 600, purpose: 'work' })
+    if (!decision.allowed) throw new Error(decision.reason)
+    service.markDispatched(decision.reservation.reservationId)
+    service.settle(decision.reservation.reservationId, { inputTokens: 600, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 })
+    await expect(h.stream(root, [usage(), finish()], { maxTokens: 10 })).rejects.toThrow('BUDGET_UNAVAILABLE')
+    await service.withPurpose('root', 'finalize', async () => {
+      await Promise.resolve()
+      await h.stream(root, [usage({ inputTokens: 10, outputTokens: 5 }), finish()], { maxTokens: 10 })
+    })
+    expect(service.snapshot('root')).toMatchObject({ usedTokens: 615, finalize: { usedTokens: 15 } })
+    await expect(h.stream(root, [usage(), finish()], { maxTokens: 10 })).rejects.toThrow('BUDGET_UNAVAILABLE')
+  })
+
+  it('adds a bounded output configuration through the actual request waterfall contract', async () => {
+    const h = new TestHarness({ maxTokens: 5000, reservationMode: true, requestMaxTokens: 128 })
+    const root = h.root('root')
+    const result = await h.request(root)
+    expect(result.maxTokens).toBe(128)
+    expect(h.lastRequestBase?.maxTokens).toBeUndefined()
+  })
+
+  it('leaves the caller output bound untouched when no request cap is configured', async () => {
+    const h = new TestHarness({ maxTokens: 5000, reservationMode: true })
+    const root = h.root('root')
+    const result = await h.request(root, { maxTokens: 256000 })
+    expect(result.maxTokens).toBe(256000)
+  })
+
+  it('runs through the real Cordis/DSH LlmRuntime with a controlled provider adapter', async () => {
+    class Adapter extends LlmAdapter {
+      calls = 0
+      override stream(_options: GenerateOptions): AsyncIterable<StreamChunk> {
+        this.calls++
+        return (async function* () { yield usage({ inputTokens: 12, outputTokens: 4 }); yield finish() })()
+      }
+    }
+    const ctx = new Context()
+    await ctx.plugin(LlmRuntime)
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(SessionProjection)
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    await ctx.plugin(AgentRegistry)
+    const fiber = ctx.plugin({ name, inject, apply }, { maxTokens: 1000, reservationMode: true, pressurePrompt: false, storageDir: mkdtempSync(join(tmpdir(), 'budget-reservation-host-')) })
+    await fiber.await()
+    try {
+      const adapter = new Adapter()
+      ctx.llm.registerAdapter(['controlled'], adapter)
+      const root = ctx.sessions.create(SessionId('root'))
+      await Array.fromAsync(ctx.llm.stream(Object.freeze({ provider: 'controlled', model: 'controlled-model', messages: [], sessionId: root.id, maxTokens: 32 })))
+      expect(adapter.calls).toBe(1)
+      const service = ctx.get('agentBudget')
+      expect(service).toBeDefined()
+      expect(service!.snapshot('root')).toMatchObject({ usedTokens: 16, reservedTokens: 0, unknownCalls: 0 })
+      service!.allocate('root', 400, 'trusted finalization test')
+      await service!.withPurpose('root', 'finalize', async () => {
+        await Promise.resolve()
+        await Array.fromAsync(ctx.llm.stream({ provider: 'controlled', model: 'controlled-model', messages: [], sessionId: root.id, maxTokens: 32 }))
+      })
+      expect(service!.snapshot('root')).toMatchObject({ usedTokens: 32, finalize: { usedTokens: 16 } })
+    } finally { await fiber.dispose() }
+  })
+})
diff --git a/tests/reservations.spec.ts b/tests/reservations.spec.ts
