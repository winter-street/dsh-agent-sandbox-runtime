diff --git a/scripts/recover-writer-lock.mjs b/scripts/recover-writer-lock.mjs
new file mode 100644
index 0000000..0a112b5
--- /dev/null
+++ b/scripts/recover-writer-lock.mjs
@@ -0,0 +1,51 @@
+#!/usr/bin/env node
+import { randomUUID } from 'node:crypto'
+import { closeSync, lstatSync, openSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs'
+import { resolve, join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+/** Explicit local recovery. PID reuse, unreadable state and unknown liveness fail closed. */
+export function recoverWriterLock(directory, expectedPid) {
+  if (!Number.isSafeInteger(expectedPid) || expectedPid <= 0) throw new TypeError('expected PID must be a positive safe integer')
+  const dir = resolve(directory)
+  const file = join(dir, 'writer.lock')
+  const guard = join(dir, 'writer-recovery.lock')
+  const guardId = JSON.stringify({ pid: process.pid, id: randomUUID() })
+  // Serialize recovery commands. A stale recovery guard requires offline inspection.
+  const guardFd = openSync(guard, 'wx', 0o600)
+  try {
+    writeFileSync(guardFd, guardId)
+    const stat = lstatSync(file)
+    if (!stat.isFile() || stat.isSymbolicLink()) throw new Error('writer lock must be a regular file')
+    const original = readFileSync(file, 'utf8')
+    const owner = JSON.parse(original)
+    if (!owner || !Number.isSafeInteger(owner.pid) || owner.pid <= 0 || typeof owner.id !== 'string' || !owner.id) {
+      throw new Error('writer lock identity is invalid; inspect offline')
+    }
+    if (owner.pid !== expectedPid) throw new Error('writer lock PID changed; refusing recovery')
+    try {
+      process.kill(owner.pid, 0)
+      throw new Error('writer process is still alive; refusing recovery')
+    } catch (error) {
+      if (!error || error.code !== 'ESRCH') throw error
+    }
+    if (readFileSync(file, 'utf8') !== original) throw new Error('writer lock identity changed; refusing recovery')
+    unlinkSync(file)
+    return { recovered: true, directory: dir, pid: owner.pid, lockId: owner.id }
+  } finally {
+    closeSync(guardFd)
+    // Never remove a replacement guard belonging to another recovery.
+    if (readFileSync(guard, 'utf8') === guardId) unlinkSync(guard)
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  const args = process.argv.slice(2)
+  if (args.length !== 4 || args[0] !== '--dir' || args[2] !== '--expected-pid') {
+    console.error('Usage: node scripts/recover-writer-lock.mjs --dir <local-storage-directory> --expected-pid <dead-pid>')
+    process.exitCode = 2
+  } else {
+    try { console.log(JSON.stringify(recoverWriterLock(args[1], Number(args[3])))) }
+    catch (error) { console.error(error.message); process.exitCode = 1 }
+  }
+}
